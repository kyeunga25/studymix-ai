# Public web configuration
VITE_API_BASE_URL=http://localhost:8787

# Non-secret Worker configuration
APP_ENV=local
GENERATION_PROVIDER=mock
REAL_GENERATION_ENABLED=false
MAX_UPLOAD_BYTES=524288000
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=900
SOURCE_RETENTION_HOURS=72
OUTPUT_RETENTION_HOURS=168
MAX_DAILY_JOBS_PER_OWNER=3
ALLOWED_WEB_ORIGINS=http://localhost:5173

# Secret names are documented only. Set real values with Wrangler secrets or .dev.vars.
FAL_KEY=
R2_S3_ACCESS_KEY_ID=
R2_S3_SECRET_ACCESS_KEY=
SESSION_SIGNING_SECRET=
TURNSTILE_SECRET_KEY=
FAL_WEBHOOK_SECRET=
