{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "studymix-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "keep_vars": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "change-me-database",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "change-me-private-audio",
    },
  ],
  "workflows": [
    {
      "binding": "GENERATION_WORKFLOW",
      "name": "change-me-generation-workflow",
      "class_name": "GenerationWorkflow",
    },
  ],
  "ratelimits": [
    {
      "name": "JOB_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "vars": {
    "APP_ENV": "production",
    "ACCESS_TEAM_DOMAIN": "https://CHANGE-ME.cloudflareaccess.com",
    "ACCESS_AUD": "CHANGE_ME",
    "DEV_AUTH_SUBJECT": "",
    "LEGAL_CONTACT_EMAIL": "CHANGE_ME",
    "GENERATION_PROVIDER": "mock",
    "REAL_GENERATION_ENABLED": "false",
    "FAL_KEY": "CHANGE_ME_FAL_KEY_000000",
    "FAL_WEBHOOK_URL": "https://webhook.invalid/api/webhooks/fal",
    "FAL_WEBHOOK_USER_ID": "CHANGE_ME_FAL_WEBHOOK_USER_ID",
    "FAL_OUTPUT_EXPIRATION_SECONDS": "3600",
    "FAL_QUEUE_START_TIMEOUT_SECONDS": "300",
    "FAL_POLL_INTERVAL_SECONDS": "10",
    "FAL_MAX_POLL_ATTEMPTS": "120",
    "MAX_PROVIDER_OUTPUT_BYTES": "104857600",
    "PROVIDER_OUTPUT_TIMEOUT_SECONDS": "120",
    "JOB_WORKFLOW_ENABLED": "false",
    "R2_TRANSFER_ENABLED": "false",
    "RETENTION_CLEANUP_ENABLED": "false",
    "R2_ACCOUNT_ID": "00000000000000000000000000000000",
    "R2_BUCKET_NAME": "change-me-private-audio",
    "R2_S3_ACCESS_KEY_ID": "CHANGE_ME_ACCESS_KEY",
    "R2_S3_SECRET_ACCESS_KEY": "CHANGE_ME_SECRET_ACCESS_KEY_000000",
    "MAX_UPLOAD_BYTES": "524288000",
    "MAX_ACTIVE_UPLOADS_PER_OWNER": "3",
    "MAX_ACTIVE_JOBS_PER_OWNER": "2",
    "MAX_DAILY_JOBS_PER_OWNER": "4",
    "ABANDONED_UPLOAD_RETENTION_HOURS": "24",
    "SOURCE_RETENTION_HOURS": "72",
    "FAILED_ARTIFACT_RETENTION_HOURS": "24",
    "OUTPUT_RETENTION_HOURS": "168",
    "RETENTION_CLEANUP_BATCH_SIZE": "50",
    "UPLOAD_URL_TTL_SECONDS": "900",
    "DOWNLOAD_URL_TTL_SECONDS": "900",
  },
}
